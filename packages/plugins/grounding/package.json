{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-grounding",
  "version": "0.0.0",
  "description": "Grounds OpenCode sessions in Trailblazer's code graph before the model acts (ours, never published)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "package.json",
    "index.ts",
    "grounding.ts",
    "trailblazer.ts",
    "verify.ts"
  ],
  "scripts": {
    "test": "bun test --timeout 30000",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode/ai": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "effect": "catalog:"
  }
}
